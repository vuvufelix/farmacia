{
  "appId": "com.nenovatech.medloteos",
  "productName": "MedLoteOS",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "public/**/*",
    "package.json",
    "node_modules/@prisma/client/**/*",
    "node_modules/.prisma/client/**/*"
  ],
  "asarUnpack": [
    "**/node_modules/@prisma/client/**/*",
    "**/node_modules/.prisma/client/**/*"
  ],
  "linux": {
    "target": ["deb"],
    "maintainer": "Nenova Tech <vuvu@nenovatech.ao>",
    "category": "Office"
  },
  "win": {
    "target": ["nsis"]
  }
}