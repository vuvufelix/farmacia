{
  "name": "nenova-pharmacy-sys",
  "version": "1.0.0",
  "description": "Sistema Desktop Offline de Gestão de Farmácia - Nenova Tech",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev:backend": "tsx watch src/backend/server.ts",
    "compile": "tsc",
    "seed": "node --import tsx seed.ts",
    "electron:dev": "concurrently \"npm run dev:backend\" \"electron .\"",
    "build": "npm run compile && electron-builder",
    "start": "electron .",
    "main": "dist/main/index.js",
    "db:reset": "node -e \"const fs = require('fs'); ['database.db', 'database.db-wal', 'database.db-shm'].forEach(f => { if (fs.existsSync(f)) { fs.unlinkSync(f); console.log(f + ' apagado.'); } }); console.log('Base de dados limpa com sucesso!');\""
  },
  "keywords": [
    "electron",
    "sqlite",
    "express",
    "angola",
    "pharmacy"
  ],
  "author": {
    "name": "Nenova Tech",
    "email": "nenovatech98@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.43",
    "concurrently": "^8.2.2",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
